{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.0"}
        metosin/malli {:mvn/version "0.20.1"}
        metosin/jsonista {:mvn/version "1.0.0"}
        cheshire/cheshire {:mvn/version "6.2.0"}
        com.walmartlabs/cond-let {:mvn/version "1.0.0"}
        clj-http/clj-http {:mvn/version "3.13.1"}}

 :aliases
  {:dev
   {:extra-paths ["dev" "test"]
    :extra-deps
    {org.clojure/tools.namespace {:mvn/version "1.5.0"}
     criterium/criterium {:mvn/version "0.4.6"}}}

   :test
  {:extra-paths ["test"]
   :extra-deps
   {io.github.cognitect-labs/test-runner
    {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test}

  :build
  {:deps
   {io.github.clojure/tools.build
    {:git/tag "v0.10.7" :git/sha "41874d3"}}
   :ns-default build}

   :run
   {:main-opts ["-m" "clj-agents.core"]
    :exec-fn clj-agents.core/-main}}}
